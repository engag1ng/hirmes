{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "resources": [
      "bin/app*"
    ],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "npm run build:flask"
  },
  "productName": "hirmes",
  "mainBinaryName": "hirmes",
  "version": "../package.json",
  "identifier": "app.hirmes",
  "plugins": {},
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Hirmes",
        "url": "http://127.0.0.1:5000",
        "width": 1600,
        "height": 1200,
        "visible": false,
        "useHttpsScheme": true
      },
      {
        "label": "splashscreen",
        "width": 1600,
        "height": 1200,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "fullscreen": false,
        "url": "splashscreen.html",
        "visible": true,
        "useHttpsScheme": true
      }
    ]
  }
}