{
  "name": "hirmes",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "build": "APPIMAGE_EXTRACT_AND_RUN=1 tauri build",
    "build:appimage": "APPIMAGE_EXTRACT_AND_RUN=1 tauri build --bundles appimage",
    "build:packages": "tauri build --bundles deb,rpm",
